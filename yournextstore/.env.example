# Frontend Environment Configuration
# Copy this file to .env.local and fill in the appropriate values

# URL of the Medusa backend instance
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (obtained from Medusa Admin -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_publishable_api_key_here

# Base URL of the storefront application
NEXT_PUBLIC_URL=http://localhost:3000

