# Frontend Environment Configuration
# Copy this file to .env.local and fill in the appropriate values

# URL of the Medusa backend instance
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (obtained from Medusa Admin -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=your_publishable_api_key_here

# Base URL of the storefront application
NEXT_PUBLIC_URL=http://localhost:3000

# Razorpay Payment Gateway Configuration
# Obtain your API keys from Razorpay Dashboard -> Settings -> API Keys (Test / Live)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
