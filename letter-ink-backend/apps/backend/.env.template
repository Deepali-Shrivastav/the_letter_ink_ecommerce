# Medusa Backend Environment Configuration
# Copy this file to .env and configure strong secrets in production

# Admin onboarding
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# CORS settings (comma-separated origins)
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:9000,http://127.0.0.1:3000

# Redis connection string (optional in dev, recommended in prod)
REDIS_URL=redis://localhost:6379

# Cryptographic secrets - MUST be replaced with cryptographically secure random values in production
# (Generate with `openssl rand -base64 32` or `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars
COOKIE_SECRET=replace_with_secure_random_cookie_secret_min_32_chars
AUTH_MFA_ENCRYPTION_KEY=replace_with_32_byte_hex_encryption_key

# PostgreSQL database connection string
DATABASE_URL=postgres://postgres:password@localhost:5433/medusa-backend
DB_NAME=medusa-backend
